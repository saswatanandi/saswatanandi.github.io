---
import ComingSoon from '../../components/ComingSoon.astro';
import ThemeTile from '../../components/ThemeTile.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getThemes } from '../../lib/collections';

const themes = await getThemes();
---

<PageLayout title="Research" description={themes.map((t) => t.data.title).join(' · ')} ridges={4}>
  <ol role="list" class="themes">
    {
      themes.map((t, i) => (
        <li>
          <ThemeTile theme={t} index={i} layout="row" />
        </li>
      ))
    }
  </ol>

  <div class="soon-wrap">
    <ComingSoon phase={4} icon="pin" title="Map of study basins">
      <p>I am adding a map of the river basins I have worked in, with links to the papers.</p>
    </ComingSoon>
  </div>
</PageLayout>

<style>
  .themes {
    display: grid;
    gap: var(--space-5);
  }
  .soon-wrap {
    margin-top: var(--space-8);
  }
</style>
