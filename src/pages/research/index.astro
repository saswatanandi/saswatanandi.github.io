---
import ThemeTile from '../../components/ThemeTile.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getThemes } from '../../lib/collections';

const themes = await getThemes();
---

<PageLayout title="Research" description={themes.map((t) => t.data.title).join(' · ')} ridges={4}>
  <ol role="list" class="themes">
    {
      themes.map((t, i) => (
        <li>
          <ThemeTile theme={t} index={i} layout="row" />
        </li>
      ))
    }
  </ol>

</PageLayout>

<style>
  .themes {
    max-width: 58rem;
    display: grid;
    gap: var(--space-5);
  }
</style>
