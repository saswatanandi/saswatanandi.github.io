---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ResearchFigure from '../../components/ResearchFigure.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublications } from '../../lib/bibtex';
import { getThemes } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';

export const getStaticPaths = (async () => {
  const themes = await getThemes();
  return themes.map((theme, i) => ({
    params: { slug: theme.id },
    props: { theme, prev: themes[i - 1], next: themes[i + 1], index: i },
  }));
}) satisfies GetStaticPaths;

interface Props {
  theme: CollectionEntry<'research'>;
  prev?: CollectionEntry<'research'>;
  next?: CollectionEntry<'research'>;
  index: number;
}
const { theme, prev, next, index } = Astro.props;
const { image, image_alt, image_caption, image_full, figures, collaborators, funding } = theme.data;

// Figure 1 is `image`; figures 2, 3, … come from the `figures:` list.
const allFigures = [
  { image, alt: image_alt, caption: image_caption, full: image_full },
  ...(figures ?? []).map((f) => ({ image: f.image, alt: f.alt, caption: f.caption, full: f.full })),
];

// The text is split at marker lines `<!-- figure -->` / `<!-- figure N -->`; each marker is
// replaced by that figure. Figures without a marker go after the text.
const MARKER = /^[ \t]*<!--\s*figure(?:\s+(\d+))?\s*-->[ \t]*$/m;
const parts = (theme.body ?? '').split(new RegExp(MARKER.source, 'gm'));
type Block = { kind: 'text'; html: string } | { kind: 'figure'; n: number };
const blocks: Block[] = [];
const placed = new Set<number>();
for (let i = 0; i < parts.length; i++) {
  if (i % 2 === 0) {
    const md = (parts[i] ?? '').trim();
    if (md) blocks.push({ kind: 'text', html: await renderMarkdown(md) });
    continue;
  }
  const n = parts[i] ? Number(parts[i]) : 1;
  if (n < 1 || n > allFigures.length) {
    throw new Error(
      `\n✖ src/content/research/${theme.id}.md: "<!-- figure ${n} -->" has no matching figure. ` +
        `This theme has ${allFigures.length} figure${allFigures.length === 1 ? '' : 's'} ` +
        `(1 = image${allFigures.length > 1 ? `, 2–${allFigures.length} = the figures: list` : ''}).\n`,
    );
  }
  if (placed.has(n)) throw new Error(`\n✖ src/content/research/${theme.id}.md: figure ${n} is placed twice.\n`);
  placed.add(n);
  blocks.push({ kind: 'figure', n });
}
for (let n = 1; n <= allFigures.length; n++) if (!placed.has(n)) blocks.push({ kind: 'figure', n });

// getPublications() is already newest first.
const pubs = getPublications().filter((p) => p.topics.includes(theme.id));
---

<PageLayout
  title={theme.data.title}
  eyebrow="Research"
  eyebrowHref="/research/"
  description={theme.data.summary}
  ridges={11 + index}
  narrow
>
  <article class="article">
    {
      blocks.map((b) =>
        b.kind === 'text' ? <div class="prose" set:html={b.html} /> : <ResearchFigure {...allFigures[b.n - 1]!} />,
      )
    }

    {
      collaborators.length > 0 && (
        <section class="meta">
          <h2 class="eyebrow">Collaborators</h2>
          <ul role="list">
            {collaborators.map((c) => (
              <li>
                {c.url ? <a href={c.url}>{c.name}</a> : c.name}
                {c.affiliation && <span class="muted"> · {c.affiliation}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      funding.length > 0 && (
        <section class="meta">
          <h2 class="eyebrow">Funding</h2>
          <ul role="list">
            {funding.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pubs.length > 0 && (
        <section class="related" aria-labelledby="related-pubs">
          <h2 id="related-pubs">Papers</h2>
          <div>
            {pubs.map((p) => (
              <PublicationItem pub={p} />
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="Research themes">
      {
        prev ? (
          <a href={`/research/${prev.id}/`} rel="prev">
            <span>Previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/research/${next.id}/`} rel="next" class="pager__next">
            <span>Next</span>
            {next.data.title}
          </a>
        )
      }
    </nav>
  </article>
</PageLayout>

<style>
  .article > * + * {
    margin-top: var(--space-6);
  }
  .prose {
    font-size: var(--text-md);
  }
  .prose :global(p + p) {
    margin-top: var(--space-4);
  }
  .meta ul {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }
  .muted {
    color: var(--color-text-faint);
  }
  .related {
    margin-top: var(--space-8);
  }
  .related h2 {
    margin-bottom: var(--space-4);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .pager a {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }
  .pager a span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .pager__next {
    text-align: right;
  }
</style>
