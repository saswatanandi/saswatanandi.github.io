---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ThemeFigure from '../../components/ThemeFigure.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublications } from '../../lib/bibtex';
import { getThemes } from '../../lib/collections';
import { renderMarkdown } from '../../lib/markdown';

export const getStaticPaths = (async () => {
  const themes = await getThemes();
  return themes.map((theme, i) => ({
    params: { slug: theme.id },
    props: { theme, prev: themes[i - 1], next: themes[i + 1], index: i },
  }));
}) satisfies GetStaticPaths;

interface Props {
  theme: CollectionEntry<'research'>;
  prev?: CollectionEntry<'research'>;
  next?: CollectionEntry<'research'>;
  index: number;
}
const { theme, prev, next, index } = Astro.props;
const { image, image_alt, image_caption, image_full, collaborators, funding } = theme.data;

// Split the page text after the first paragraph so the figure sits inside the reading flow.
const paras = (theme.body ?? '').trim().split(/\n\s*\n/);
const leadHtml = await renderMarkdown(paras[0] ?? '');
const restHtml = paras.length > 1 ? await renderMarkdown(paras.slice(1).join('\n\n')) : '';

// Raster figures (screenshots, photos) open full size when clicked.
const rasters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/research/*.{png,jpg,jpeg,webp,avif,PNG,JPG,JPEG}', { eager: true });
const rasterMeta = rasters[`/src/assets/research/${image}`]?.default;
const rasterHref = rasterMeta ? (await getImage({ src: rasterMeta, width: rasterMeta.width })).src : undefined;
// getPublications() is already newest first.
const pubs = getPublications().filter((p) => p.topics.includes(theme.id));
---

<PageLayout
  title={theme.data.title}
  eyebrow="Research"
  eyebrowHref="/research/"
  intro={theme.data.summary}
  description={theme.data.summary}
  ridges={11 + index}
  narrow
>
  <article class="article">
    <div class="prose" set:html={leadHtml} />

    <figure class="figure">
      {
        rasterHref ? (
          <a href={rasterHref} class="figure__zoom" aria-label="Open the full-size image">
            <ThemeFigure src={image} alt={image_alt} />
          </a>
        ) : (
          <ThemeFigure src={image} alt={image_alt} />
        )
      }
      {
        (image_caption || image_full) && (
          <figcaption>
            {image_caption}
            {image_full && (
              <>
                {' '}
                <a href={image_full}>
                  View full diagram<span aria-hidden="true"> ↗</span>
                </a>
              </>
            )}
          </figcaption>
        )
      }
    </figure>

    {restHtml && <div class="prose" set:html={restHtml} />}

    {
      collaborators.length > 0 && (
        <section class="meta">
          <h2 class="eyebrow">Collaborators</h2>
          <ul role="list">
            {collaborators.map((c) => (
              <li>
                {c.url ? <a href={c.url}>{c.name}</a> : c.name}
                {c.affiliation && <span class="muted"> · {c.affiliation}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      funding.length > 0 && (
        <section class="meta">
          <h2 class="eyebrow">Funding</h2>
          <ul role="list">
            {funding.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      pubs.length > 0 && (
        <section class="related" aria-labelledby="related-pubs">
          <h2 id="related-pubs">Papers</h2>
          <div>
            {pubs.map((p) => (
              <PublicationItem pub={p} />
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="Research themes">
      {
        prev ? (
          <a href={`/research/${prev.id}/`} rel="prev">
            <span>Previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/research/${next.id}/`} rel="next" class="pager__next">
            <span>Next</span>
            {next.data.title}
          </a>
        )
      }
    </nav>
  </article>
</PageLayout>

<style>
  .article > * + * {
    margin-top: var(--space-6);
  }
  .prose {
    font-size: var(--text-md);
  }
  .prose :global(p + p) {
    margin-top: var(--space-4);
  }
  .figure {
    margin-block: var(--space-7);
    margin-inline: 0;
  }
  .figure__zoom {
    display: block;
    cursor: zoom-in;
  }
  .figure :global(.tfig) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }
  .figure :global(.tfig > svg) {
    padding: var(--space-4);
  }
  .figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
  .figure figcaption a {
    font-weight: 600;
    white-space: nowrap;
  }
  .meta ul {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }
  .muted {
    color: var(--color-text-faint);
  }
  .related {
    margin-top: var(--space-8);
  }
  .related h2 {
    margin-bottom: var(--space-4);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .pager a {
    display: grid;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }
  .pager a span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .pager__next {
    text-align: right;
  }
</style>
