---
import ComingSoon from '../components/ComingSoon.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getSoftware } from '../lib/collections';

const items = await getSoftware();
---

<PageLayout
  title="Software"
  eyebrow="Open source"
  intro="Open-source tools I have written and still look after."
  contour="30% 20%"
>
  <div class="grid">
    {items.map((item) => <SoftwareCard item={item} feature={item.data.featured} />)}
  </div>

  <div class="soon">
    <ComingSoon phase={3} icon="package" title="More coming soon">
      <p>This page is being rebuilt. A full IMDLIB page and my other projects will be here soon.</p>
    </ComingSoon>
  </div>
</PageLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-5);
  }
  .soon {
    margin-top: var(--space-8);
  }
</style>
