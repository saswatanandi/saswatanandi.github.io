---
import ComingSoon from '../components/ComingSoon.astro';
import PublicationItem from '../components/PublicationItem.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getPublications } from '../lib/bibtex';
import { site } from '../lib/config';

const pubs = getPublications();
---

<PageLayout
  title="Publications"
  eyebrow="Publications"
  intro="My papers, book chapters and talks."
  contour="70% 30%"
>
  <ComingSoon phase={2} icon="book" title="Full list coming soon">
    <p>
      This page is being rebuilt. The full list will be here soon.{
        site.links.scholar && (
          <>
            {' '}Meanwhile, see my <a href={site.links.scholar}>Google Scholar</a> page.
          </>
        )
      }
    </p>
  </ComingSoon>

  <section class="list" aria-labelledby="sel">
    <h2 id="sel">Selected papers</h2>
    <div>
      {pubs.map((p) => <PublicationItem pub={p} />)}
    </div>
  </section>
</PageLayout>

<style>
  .list {
    margin-top: var(--space-8);
    max-width: 58rem;
  }
  .list h2 {
    margin-bottom: var(--space-4);
  }
</style>
