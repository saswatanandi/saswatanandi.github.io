---
/** A longer note on something read: /reading/<note>/, text from src/content/reading/notes/<note>.md. */
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Icon from '../../components/Icon.astro';
import ShareRow from '../../components/ShareRow.astro';
import CodeCopy from '../../components/blog/CodeCopy.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { READING_TYPE_ACTION, READING_TYPE_LABEL, getReadingNotes, readingHref } from '../../lib/collections';
import { formatDate, formatYearMonth, isoDate } from '../../lib/format';
import { ogCardPath } from '../../lib/og';

export const getStaticPaths = (async () => {
  const pairs = await getReadingNotes();
  return pairs.map(({ entry, note }) => ({ params: { slug: note.id }, props: { entry, note } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'reading'>;
  note: CollectionEntry<'readingNotes'>;
}
const { entry, note } = Astro.props;
const r = entry.data;
const { Content } = await render(note);
const href = readingHref(entry);
const tags = r.tags;
const pageTitle = note.data.title ?? r.title;
---

<PageLayout
  title={pageTitle}
  eyebrow="Reading"
  image={ogCardPath('reading', note.id)}
  imageAlt={pageTitle}
  eyebrowHref="/reading/"
  description={r.why}
  ridges={9}
  narrow
>
  <Fragment slot="header">
    <div class="ref">
      <p class="ref__kind">
        <span>{READING_TYPE_LABEL[r.type]}</span>
        {r.must_read && (
          <span class="ref__must">
            <Icon name="star" size={12} /> Must read
          </span>
        )}
      </p>
      {note.data.title && <p class="ref__title">{r.title}</p>}
      {(r.authors || r.venue || r.year) && (
        <p class="ref__src">
          {r.authors}
          {r.venue && (
            <>
              {r.authors && ' · '}
              <em>{r.venue}</em>
            </>
          )}
          {r.year && (r.authors || r.venue ? ` · ${r.year}` : r.year)}
        </p>
      )}
      <p class="ref__meta">
        {
          href && (
            <a class="btn" href={href}>
              <Icon name={r.doi ? 'doi' : 'external'} /> {r.doi ? `doi:${r.doi}` : READING_TYPE_ACTION[r.type]}
            </a>
          )
        }
        <span>Read {formatYearMonth(r.read)}</span>
        {note.data.date && <time datetime={isoDate(note.data.date)}>· note written {formatDate(note.data.date)}</time>}
      </p>
    </div>
  </Fragment>

  <article class="article">
    <p class="why"><span>In one line:</span> {r.why}</p>
    <div class="prose">
      <Content />
    </div>
    {
      tags.length > 0 && (
        <ul role="list" class="tags" aria-label="Tags">
          {tags.map((t) => (
            <li>
              <a class="chip" href={`/reading/?tag=${encodeURIComponent(t)}`}>
                {t}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <ShareRow text={pageTitle} description={r.why} />
    <p class="back">
      <a class="more-link" href="/reading/"><span aria-hidden="true">←</span> All reading</a>
    </p>
  </article>
  <CodeCopy />
</PageLayout>

<style>
  .ref {
    margin-top: var(--space-4);
  }
  .ref__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .ref__must {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--color-accent);
  }
  .ref__must :global(svg) {
    fill: currentColor;
  }
  .ref__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
  }
  .ref__src {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }
  .ref__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }
  .ref__meta .btn {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .article {
    padding-bottom: var(--space-8);
  }
  .why {
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .why span {
    font-weight: 600;
  }
  .prose {
    font-size: var(--text-md);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-7);
  }
  .tags .chip {
    text-decoration: none;
  }
  .back {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
</style>
