---
/** /reading/: papers from src/data/reading.yaml, grouped by the month read, with a tag filter. */
import Icon from '../../components/Icon.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getReading, readingHref } from '../../lib/collections';

const items = await getReading();

// Group by month read (already newest first).
const groups: { month: string; label: string; items: typeof items }[] = [];
for (const r of items) {
  const last = groups.at(-1);
  if (last && last.month === r.data.read) last.items.push(r);
  else
    groups.push({
      month: r.data.read,
      label: new Date(`${r.data.read}-01T00:00:00Z`).toLocaleDateString('en-GB', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }),
      items: [r],
    });
}

// Tags, most used first.
const counts = new Map<string, number>();
for (const r of items) for (const t of r.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([t]) => t);
---

<PageLayout
  title="Reading"
  eyebrow="Reading"
  intro="Papers I have read, with a line on why each one is worth reading."
  ridges={7}
>
  {
    items.length === 0 ? (
      <div class="empty">
        <span class="empty__icon">
          <Icon name="book" size={24} />
        </span>
        <div>
          <h2 class="empty__title">Nothing here yet</h2>
          <p>I add papers as I read them. The first ones will appear here soon.</p>
        </div>
      </div>
    ) : (
      <div class="reading" data-reading>
        {tags.length > 1 && (
          <div class="filter" data-filter hidden>
            <p class="filter__label" id="filter-label">
              Filter by tag
            </p>
            <ul role="list" class="filter__tags" aria-labelledby="filter-label">
              <li>
                <button type="button" class="tag" data-tag="" aria-pressed="true">
                  All
                </button>
              </li>
              {tags.map((t) => (
                <li>
                  <button type="button" class="tag" data-tag={t} aria-pressed="false">
                    {t}
                  </button>
                </li>
              ))}
            </ul>
            <p class="filter__status" aria-live="polite" data-status />
          </div>
        )}

        {groups.map((g) => (
          <section class="month" aria-labelledby={`m-${g.month}`} data-month>
            <h2 id={`m-${g.month}`} class="month__title">
              <time datetime={g.month}>{g.label}</time>
            </h2>
            <ol role="list" class="entries">
              {g.items.map((r) => {
                const href = readingHref(r);
                return (
                  <li class="entry" data-tags={r.data.tags.join(' ')}>
                    <h3 class="entry__title">
                      {href ? <a href={href}>{r.data.title}</a> : r.data.title}
                      {r.data.draft && <span class="chip">draft</span>}
                    </h3>
                    <p class="entry__src">
                      {r.data.authors}
                      {r.data.venue && (
                        <>
                          {' · '}
                          <em>{r.data.venue}</em>
                        </>
                      )}
                      {' · '}
                      {r.data.year}
                    </p>
                    <p class="entry__why">{r.data.why}</p>
                    {(r.data.tags.length > 0 || r.data.note) && (
                      <div class="entry__foot">
                        {r.data.tags.length > 0 && (
                          <ul role="list" class="entry__tags" aria-label="Tags">
                            {r.data.tags.map((t) => (
                              <li>
                                <a class="chip" href={`/reading/?tag=${encodeURIComponent(t)}`} data-tag-link={t}>
                                  {t}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                        {r.data.note && (
                          <a class="more-link entry__note" href={`/reading/${r.data.note}/`}>
                            Read note <span aria-hidden="true">→</span>
                            <span class="visually-hidden">on “{r.data.title}”</span>
                          </a>
                        )}
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</PageLayout>

<script>
  // Tag filter (the list works without it). ?tag=x in the address selects a tag.
  const root = document.querySelector<HTMLElement>('[data-reading]');
  const bar = root?.querySelector<HTMLElement>('[data-filter]');
  if (root && bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button[data-tag]')];
    const entries = [...root.querySelectorAll<HTMLElement>('.entry')];
    const months = [...root.querySelectorAll<HTMLElement>('[data-month]')];
    const status = bar.querySelector<HTMLElement>('[data-status]')!;

    const apply = (tag: string, push = false) => {
      if (tag && !buttons.some((b) => b.dataset.tag === tag)) tag = '';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
      let shown = 0;
      for (const e of entries) {
        const on = !tag || (e.dataset.tags ?? '').split(' ').includes(tag);
        e.hidden = !on;
        if (on) shown++;
      }
      for (const m of months) m.hidden = !m.querySelector('.entry:not([hidden])');
      status.textContent = tag ? `${shown} ${shown === 1 ? 'paper' : 'papers'} tagged “${tag}”` : '';
      if (push) {
        const url = new URL(location.href);
        if (tag) url.searchParams.set('tag', tag);
        else url.searchParams.delete('tag');
        history.replaceState(null, '', url);
      }
    };

    bar.addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('button[data-tag]');
      if (b) apply(b.dataset.tag ?? '', true);
    });
    root.addEventListener('click', (ev) => {
      const a = (ev.target as Element).closest<HTMLAnchorElement>('a[data-tag-link]');
      if (!a) return;
      ev.preventDefault();
      apply(a.dataset.tagLink ?? '', true);
      bar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    apply(new URLSearchParams(location.search).get('tag') ?? '');
  }
</script>

<style>
  .reading {
    max-width: var(--width-prose);
    padding-bottom: var(--space-8);
  }

  /* Filter ----------------------------------------------------------------- */
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
  }
  .filter[hidden] {
    display: none;
  }
  .filter__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .filter__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.4;
    cursor: pointer;
  }
  .tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .tag[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .filter__status {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .filter__status:empty {
    display: none;
  }

  /* Months and entries ----------------------------------------------------- */
  .month + .month {
    margin-top: var(--space-7);
  }
  .month[hidden] {
    display: none;
  }
  .month__title {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .entries {
    display: grid;
  }
  .entry {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .entry:last-child {
    border-bottom: 0;
  }
  .entry[hidden] {
    display: none;
  }
  .entry__title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
  .entry__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .entry__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .entry__title .chip {
    margin-left: var(--space-2);
    vertical-align: middle;
  }
  .entry__src {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .entry__why {
    margin-top: var(--space-2);
  }
  .entry__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
  }
  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .entry__tags .chip {
    text-decoration: none;
  }
  .entry__tags .chip:hover {
    color: var(--color-accent);
  }
  .entry__note {
    margin-left: auto;
  }

  /* Empty state ------------------------------------------------------------ */
  .empty {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 38rem;
    margin-bottom: var(--space-8);
    padding: var(--space-5) var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }
  .empty__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
  .empty__title {
    font-size: var(--text-lg);
    color: var(--color-text);
  }
  .empty p {
    margin-top: var(--space-1);
  }
</style>
