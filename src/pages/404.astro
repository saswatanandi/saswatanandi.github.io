---
import ContourBand from '../components/ContourBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/config';
---

<BaseLayout title="Page not found" description="Page not found." noindex>
  <section class="nf">
    <ContourBand fade="radial" position="40% 50%" />
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="nf__text">
        This link may be from my old site. I rebuilt the site in 2026 and some addresses changed. Try one of these:
      </p>
      <ul role="list" class="nf__links">
        <li><a class="btn btn--primary" href="/">Home</a></li>
        {
          site.nav.map((n) => (
            <li>
              <a class="btn" href={n.href}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-9);
    min-height: 60vh;
  }
  .nf h1 {
    margin-top: var(--space-3);
    max-width: 18ch;
  }
  .nf__text {
    margin-top: var(--space-4);
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
</style>
