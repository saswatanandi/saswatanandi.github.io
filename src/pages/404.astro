---
import Ridgelines from '../components/Ridgelines.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/config';

// Old site (Hugo) addresses all started with /en/. Known ones have their own redirect pages
// (src/lib/redirects.mjs); for any other /en/... address, try the same address without /en/
// (with the old section names mapped to the new ones) before showing this page.
const oldSiteScript = `(function(){var p=location.pathname;if(!/^\\/en(\\/|$)/.test(p))return;p=p.replace(/^\\/en/,'')||'/';p=p.replace(/^\\/posts(\\/|$)/,'/blog$1').replace(/^\\/softwares(\\/|$)/,'/software$1').replace(/^\\/publication(\\/|$)/,'/publications$1').replace(/^\\/categories(\\/|$)/,'/tags$1');if(/^\\/blog\\//.test(p))p=p.replace(/_/g,'-');location.replace(p+location.search+location.hash);})();`;
---

<BaseLayout title="Page not found" description="Page not found." noindex>
  <script is:inline set:html={oldSiteScript} />
  <section class="nf">
    <Ridgelines variant="page" seed={404} />
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="nf__text">
        This link may be from my old site. I rebuilt the site in 2026 and some addresses changed. Try one of these:
      </p>
      <ul role="list" class="nf__links">
        <li><a class="btn btn--primary" href="/">Home</a></li>
        {
          site.nav.map((n) => (
            <li>
              <a class="btn" href={n.href}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-9);
    min-height: 60vh;
  }
  .nf h1 {
    margin-top: var(--space-3);
    max-width: var(--width-heading);
  }
  .nf__text {
    margin-top: var(--space-4);
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
</style>
