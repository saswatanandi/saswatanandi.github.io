---
import EmailLink from '../components/EmailLink.astro';
import HeadshotFrame from '../components/HeadshotFrame.astro';
import Icon from '../components/Icon.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Ridgelines from '../components/Ridgelines.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import ThemeTile from '../components/ThemeTile.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSelectedPublications } from '../lib/bibtex';
import { getNews, getPosts, getReading, getSoftware, getThemes } from '../lib/collections';
import { site } from '../lib/config';
import { formatDate, formatMonth, formatYearMonth, isoDate } from '../lib/format';
import { renderInline, renderMarkdown } from '../lib/markdown';

const bioHtml = await renderMarkdown(site.bio);
const themes = await getThemes();
const news = (await getNews()).slice(0, 5);
const newsHtml = await Promise.all(news.map((n) => renderInline(n.data.text)));
const selected = getSelectedPublications().slice(0, 4);
const featured = (await getSoftware()).find((s) => s.data.featured);
const latestPost = (await getPosts())[0];
const latestReading = (await getReading())[0];

const m = site.metrics;
const metrics = [
  { label: 'Citations', value: m.citations },
  { label: 'h-index', value: m.h_index },
  { label: 'i10-index', value: m.i10 },
].filter((x): x is { label: string; value: number } => typeof x.value === 'number');
---

<BaseLayout type="profile">
  <!-- ── Profile ─────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-name">
    <Ridgelines variant="hero" />
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">
          <span class="hero__dot" aria-hidden="true"></span>
          Hydrology
        </p>
        <h1 id="hero-name" class="hero__name">{site.name}</h1>
        <p class="hero__role">
          <span>{site.role}</span>
          {
            site.affiliation.name && (
              <span class="hero__aff">
                {site.affiliation.url ? <a href={site.affiliation.url}>{site.affiliation.name}</a> : site.affiliation.name}
              </span>
            )
          }
          {
            site.location && (
              <span class="hero__loc">
                <Icon name="pin" size={15} />
                {site.location}
              </span>
            )
          }
        </p>
        <div class="hero__bio" set:html={bioHtml} />

        <ul role="list" class="hero__links" id="contact" aria-label="CV and profiles">
          {
            site.cv && (
              <li>
                <a class="btn btn--primary" href={site.cv}>
                  <Icon name="cv" /> CV
                </a>
              </li>
            )
          }
          {
            site.links.scholar && (
              <li>
                <a class="btn" href={site.links.scholar} rel="me">
                  <Icon name="scholar" /> Scholar
                </a>
              </li>
            )
          }
          {
            site.links.orcid && (
              <li>
                <a class="btn" href={site.links.orcid} rel="me">
                  <Icon name="orcid" /> ORCID
                </a>
              </li>
            )
          }
          {
            site.links.github && (
              <li>
                <a class="btn" href={site.links.github} rel="me">
                  <Icon name="github" /> GitHub
                </a>
              </li>
            )
          }
          {
            site.email && (
              <li>
                <EmailLink email={site.email} class="btn" label="Email">
                  <Icon name="mail" /> Email
                </EmailLink>
              </li>
            )
          }
        </ul>

        {
          metrics.length > 0 && (
            <dl class="metrics" aria-label={`Citation metrics${m.source ? ` (${m.source})` : ''}`}>
              {metrics.map((x) => (
                <div>
                  <dt>{x.label}</dt>
                  <dd>{x.value.toLocaleString('en')}</dd>
                </div>
              ))}
              {(m.source || m.updated) && (
                <p class="metrics__src">
                  {m.source}
                  {m.updated && <> · {formatMonth(m.updated)}</>}
                </p>
              )}
            </dl>
          )
        }
      </div>
      <div class="hero__photo">
        <HeadshotFrame src="/images/headshot.jpg" alt={`Photo of ${site.name}`} />
      </div>
    </div>
  </section>

  <!-- ── Research themes ─────────────────────────────────────── -->
  {
    themes.length > 0 && (
      <section class="container section" aria-labelledby="research">
        <SectionHeader id="research" title="Research" more={{ href: '/research/', label: 'All research' }} />
        <ul role="list" class="tiles">
          {themes.map((t, i) => (
            <li>
              <ThemeTile theme={t} index={i} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ── News + selected publications ────────────────────────── -->
  <div class="container section split">
    {
      news.length > 0 && (
        <section class="split__news" aria-labelledby="news">
          <SectionHeader id="news" title="News" />
          <ol role="list" class="news">
            {news.map((n, i) => (
              <li class="news__item">
                <time datetime={isoDate(n.data.date)}>{formatMonth(n.data.date)}</time>
                <p>
                  <Fragment set:html={newsHtml[i]} />
                  {n.data.link && (
                    <>
                      {' '}
                      <a class="news__link" href={n.data.link}>
                        Read <span class="visually-hidden">more about this news item</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      selected.length > 0 && (
        <section class="split__pubs" aria-labelledby="selected-pubs">
          <SectionHeader id="selected-pubs" title="Selected papers" more={{ href: '/publications/', label: 'All publications' }} />
          <div class="pubs">
            {selected.map((p) => (
              <PublicationItem pub={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <!-- ── Software ────────────────────────────────────────────── -->
  {
    featured && (
      <section class="container section" aria-labelledby="software">
        <SectionHeader id="software" title="Software" more={{ href: '/software/', label: 'All software' }} />
        <SoftwareCard item={featured} feature />
      </section>
    )
  }

  <!-- ── Writing & reading (hidden until there is content) ───── -->
  {
    (latestPost || latestReading) && (
      <section class="container section" aria-labelledby="writing">
        <SectionHeader id="writing" title="Blog and reading" />
        <div class="notes">
          {latestPost && (
            <a class="note-card" href={`/blog/${latestPost.id}/`}>
              <span class="note-card__kind">
                <Icon name="docs" size={16} /> Latest post
              </span>
              <span class="note-card__title">{latestPost.data.title}</span>
              <span class="note-card__desc">{latestPost.data.description}</span>
              <time class="note-card__date" datetime={isoDate(latestPost.data.date)}>
                {formatDate(latestPost.data.date)}
              </time>
            </a>
          )}
          {latestReading && (
            <a class="note-card" href="/reading/">
              <span class="note-card__kind">
                <Icon name="book" size={16} /> Recently read
              </span>
              <span class="note-card__title">{latestReading.data.title}</span>
              <span class="note-card__desc">{latestReading.data.why}</span>
              <span class="note-card__date">
                {latestReading.data.authors} · {latestReading.data.journal ?? ''} {latestReading.data.year} · read{' '}
                {formatYearMonth(latestReading.data.read)}
              </span>
            </a>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    position: relative;
    isolation: isolate;
    /* the bottom padding is the room the ridgelines live in */
    padding-block: var(--space-8) calc(var(--space-5) + 128px);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-7);
  }
  .hero__eyebrow {
    color: var(--color-text-muted);
  }
  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-warm);
  }
  .hero__name {
    margin-top: var(--space-3);
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4.1rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.02;
  }
  .hero__role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
  .hero__role > span:first-child {
    color: var(--color-text);
    font-weight: 550;
  }
  .hero__aff::before,
  .hero__loc::before {
    content: '';
  }
  .hero__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--text-sm);
  }
  .hero__bio {
    margin-top: var(--space-5);
    max-width: 62ch;
    font-size: var(--text-md);
    line-height: 1.7;
  }
  .hero__bio :global(p + p) {
    margin-top: var(--space-3);
  }
  .hero__bio :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .hero__photo {
    display: grid;
    place-items: center;
    width: clamp(240px, 26vw, 320px);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    max-width: 36rem;
  }
  .metrics dt {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .metrics__src {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* Sections --------------------------------------------------------------- */
  .section {
    margin-top: var(--space-8);
  }
  /* 5 tiles: 3 on the first row, 2 wider ones on the second. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .tiles > li {
    grid-column: span 2;
  }
  .tiles > li:nth-child(4):nth-last-child(2),
  .tiles > li:nth-child(5):last-child {
    grid-column: span 3;
  }
  @media (max-width: 60rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tiles > li,
    .tiles > li:nth-child(4):nth-last-child(2),
    .tiles > li:nth-child(5):last-child {
      grid-column: auto;
    }
    .tiles > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 36rem) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  .news {
    position: relative;
  }
  .news__item {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: 0 0 var(--space-5) var(--space-5);
    border-left: 1px solid var(--color-border-strong);
  }
  .news__item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .news__item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.3rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent-2);
  }
  .news__item:first-child::before {
    background: var(--color-warm);
    border-color: var(--color-warm);
  }
  .news time {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    line-height: 1.4;
  }
  .news p {
    font-size: 0.975rem;
    line-height: 1.6;
  }
  .news__link {
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Writing & reading ------------------------------------------------------ */
  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
  .note-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease);
  }
  .note-card:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }
  .note-card__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .note-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
  }
  .note-card__desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .note-card__date {
    margin-top: auto;
    color: var(--color-text-faint);
    font-size: var(--text-xs);
  }

  /* Responsive ------------------------------------------------------------- */
  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 46rem) {
    .hero {
      padding-block: var(--space-6) calc(var(--space-5) + 104px);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero__photo {
      order: -1;
      width: 190px;
      justify-self: start;
      margin-left: -0.6rem;
    }
    .hero__bio {
      font-size: var(--text-base);
    }
    .section {
      margin-top: var(--space-7);
    }
  }
</style>
