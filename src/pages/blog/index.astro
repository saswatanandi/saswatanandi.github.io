---
import PostList from '../../components/blog/PostList.astro';
import Pager from '../../components/blog/Pager.astro';
import Icon from '../../components/Icon.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { POSTS_PER_PAGE } from '../../lib/blog';
import { getPosts } from '../../lib/collections';

const posts = await getPosts();
const pages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<PageLayout title="Blog" description="Notes and how-to posts on hydrology and climate data." ridges={5} search={false}>
  <p slot="header" class="feed">
    <a href="/tags/">All tags</a>
    <span aria-hidden="true">·</span>
    <a href="/rss.xml"><Icon name="rss" size={14} /> RSS feed</a>
  </p>
  {posts.length > 0 ? <PostList posts={posts.slice(0, POSTS_PER_PAGE)} /> : <p class="empty">No posts yet.</p>}
  <Pager current={1} total={pages} />
</PageLayout>

<style>
  .feed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }
  .feed a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .feed span {
    color: var(--color-text-faint);
  }
  .empty {
    color: var(--color-text-muted);
    margin-bottom: var(--space-7);
  }
</style>
