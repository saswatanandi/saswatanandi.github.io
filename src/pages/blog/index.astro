---
import ComingSoon from '../../components/ComingSoon.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPosts } from '../../lib/collections';
import { formatDate, isoDate } from '../../lib/format';

const posts = await getPosts();
---

<PageLayout
  title="Blog"
  eyebrow="Blog"
  intro="Notes and how-to posts on hydrology and climate data."
  ridges={5}
>
  {
    posts.length > 0 && (
      <ol role="list" class="posts">
        {posts.map((p) => (
          <li>
            <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
            <h2>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.draft && <span class="chip">draft</span>}
            </h2>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ol>
    )
  }

  <ComingSoon phase={3} icon="docs" title="Posts coming soon">
    <p>
      I am moving my old posts here, including the IMDLIB tutorials. The RSS feed is at <a href="/rss.xml">/rss.xml</a>.
    </p>
  </ComingSoon>
</PageLayout>

<style>
  .posts {
    display: grid;
    gap: var(--space-6);
    max-width: var(--width-prose);
    margin-bottom: var(--space-7);
  }
  .posts time {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .posts h2 {
    font-size: var(--text-lg);
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .posts h2 a {
    color: var(--color-text);
    text-decoration: none;
  }
  .posts h2 a:hover {
    color: var(--color-accent);
  }
  .posts p {
    color: var(--color-text-muted);
  }
</style>
