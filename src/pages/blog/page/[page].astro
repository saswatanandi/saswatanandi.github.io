---
/** /blog/page/2/, /blog/page/3/, … (only when there are more than POSTS_PER_PAGE posts). */
import type { GetStaticPaths } from 'astro';
import PostList from '../../../components/blog/PostList.astro';
import Pager from '../../../components/blog/Pager.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { POSTS_PER_PAGE, type Post } from '../../../lib/blog';
import { getPosts } from '../../../lib/collections';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: { page, total, posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE) },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  page: number;
  total: number;
  posts: Post[];
}
const { page, total, posts } = Astro.props;
---

<PageLayout title={`Blog, page ${page}`} eyebrow="Blog" eyebrowHref="/blog/" ridges={5} search={false}>
  <PostList posts={posts} />
  <Pager current={page} total={total} />
</PageLayout>
