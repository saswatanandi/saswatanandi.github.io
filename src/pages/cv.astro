---
/**
 * /cv/ — web CV. Content: src/data/cv.yaml (+ publications from publications.bib).
 * Sections are built by src/lib/cv.ts, which also feeds the Typst PDF (cv/cv.typ),
 * so the page and /cv.pdf always match.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry } from 'astro:content';
import EmailLink from '../components/EmailLink.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { getPublications } from '../lib/bibtex';
import { site } from '../lib/config';
import {
  authorSep,
  boldSegments,
  cvSections,
  formatUpdated,
  PLAIN_SECTIONS,
  pubGroups,
  withPublications,
  type CvPubGroup,
  type CvSection,
} from '../lib/cv';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('src/data/cv.yaml is missing');
const cv = entry.data;

const rowSections = cvSections(cv);
const pubs: CvPubGroup[] = pubGroups(getPublications());
type Block = CvSection | { id: 'publications'; title: string; pubs: CvPubGroup[] };
const blocks: Block[] = pubs.length
  ? withPublications<Block>(rowSections, { id: 'publications', title: 'Publications', pubs })
  : rowSections;
const summary = cv.summary ? boldSegments(cv.summary) : [];
const pubCount = pubs.reduce((n, g) => n + g.entries.length, 0);

const updated = formatUpdated(cv.updated ?? new Date().toISOString().slice(0, 10));
/** The PDF is generated by `npm run cv:pdf` (in CI before the build). */
const hasPdf = existsSync(join(process.cwd(), 'public', 'cv.pdf'));

const bare = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
type Contact = { icon: IconName; label: string; href: string };
const contact = (href: string | undefined, icon: IconName, label: string): Contact[] =>
  href ? [{ icon, label, href }] : [];
const { orcid, scholar, github, linkedin } = site.links;
const contacts: Contact[] = [
  ...contact(orcid, 'orcid', orcid ? bare(orcid) : ''),
  ...contact(scholar, 'scholar', 'Google Scholar'),
  ...contact(github, 'github', github ? bare(github) : ''),
  ...contact(linkedin, 'linkedin', 'LinkedIn'),
];
---

<PageLayout
  title="Curriculum vitae"
  eyebrow="CV"
  description={`Curriculum vitae of ${site.name}: positions, education, ${pubCount} publications, and more.`}
  ridges={6}
  narrow
>
  <div slot="header" class="cv-id">
    <p class="cv-id__name">{site.name}</p>
    <p class="cv-id__role">
      <span>{site.role}</span>
      {
        site.affiliation.name && (
          <span>{site.affiliation.url ? <a href={site.affiliation.url}>{site.affiliation.name}</a> : site.affiliation.name}</span>
        )
      }
      {site.location && <span>{site.location}</span>}
    </p>
    <ul role="list" class="cv-contact" aria-label="Contact and profiles">
      {
        site.email && (
          <li>
            <EmailLink email={site.email} label="Email" class="cv-contact__email">
              <Icon name="mail" size={15} />
              <span data-email-text>Email</span>
            </EmailLink>
          </li>
        )
      }
      {
        contacts.map((c) => (
          <li>
            <a href={c.href} rel="me">
              <Icon name={c.icon} size={15} />
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="cv-actions">
      {
        hasPdf ? (
          <a class="btn btn--primary" href="/cv.pdf" download="Saswata-Nandi-CV.pdf">
            <Icon name="download" /> Download PDF
          </a>
        ) : (
          <span class="btn cv-actions__soon" aria-disabled="true">
            <Icon name="cv" /> PDF coming soon
          </span>
        )
      }
      <p class="cv-actions__updated">Updated {updated}</p>
    </div>
  </div>

  {cv.notice && <p class="cv-notice">{cv.notice}</p>}

  {
    summary.length > 0 && (
      <p class="cv-summary">{summary.map((x) => (x.bold ? <strong>{x.text}</strong> : x.text))}</p>
    )
  }

  <nav class="cv-nav" aria-label="CV sections">
    <ul role="list">
      {
        blocks.map((b) => (
          <li>
            <a href={`#${b.id}`}>{b.title}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="cv">
    {
      blocks.map((b) => (
        <section class="cv-section" id={b.id} aria-labelledby={`${b.id}-title`}>
          <h2 id={`${b.id}-title`}>{b.title}</h2>
          {'pubs' in b
            ? b.pubs.map((g) => (
                <div class="cv-group">
                  <h3>
                    {g.heading} <span class="cv-group__count">{g.entries.length}</span>
                  </h3>
                  <ol role="list" class="cv-rows">
                    {g.entries.map((p) => (
                      <li class="cv-row cv-row--pub">
                        <p class="cv-row__when cv-row__label">
                          <span class="visually-hidden">Item </span>
                          {p.label}
                        </p>
                        <p class="cv-row__body cv-cite">
                          {p.authors.map((a, i) => (
                            <>
                              {a.self ? <strong>{a.name}</strong> : a.name}
                              {authorSep(i, p.authors.length)}
                            </>
                          ))}{' '}
                          ({p.year}). {p.url ? <a href={p.url}>{p.title}</a> : p.title}.{' '}
                          {p.venue && <em>{p.venue}</em>}
                          {p.details && <>, {p.details}</>}.
                        </p>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            : b.groups.map((g) => (
                <div class="cv-group">
                  {g.heading && <h3>{g.heading}</h3>}
                  {g.rows.length > 0 && (
                    <ol role="list" class:list={['cv-rows', { 'cv-rows--plain': PLAIN_SECTIONS.includes(b.id) }]}>
                      {g.rows.map((r) => (
                        <li class="cv-row">
                          <p class="cv-row__when">{r.when}</p>
                          <div class="cv-row__body">
                            <p class="cv-row__title">{r.url ? <a href={r.url}>{r.title}</a> : r.title}</p>
                            {r.lines.map((l, i) => (
                              <p class="cv-row__line">{i === 0 && r.lineUrl ? <a href={r.lineUrl}>{l}</a> : l}</p>
                            ))}
                            {r.bullets.length > 0 && (
                              <ul class="cv-row__bullets">
                                {r.bullets.map((x) => (
                                  <li>{x}</li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </li>
                      ))}
                    </ol>
                  )}
                  {g.list && g.list.length > 0 && (
                    <ul role="list" class="cv-inline">
                      {g.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  {g.note && <p class="cv-inline cv-inline__note">{g.note}</p>}
                </div>
              ))}
        </section>
      ))
    }
  </div>
</PageLayout>

<script>
  // Show the address itself (decoded like EmailLink does), so a printout has it too.
  document.querySelectorAll<HTMLAnchorElement>('.cv-contact__email').forEach((a) => {
    const text = a.querySelector('[data-email-text]');
    try {
      const addr = [...atob(a.dataset.email ?? '')].reverse().join('');
      if (text && addr.includes('@')) text.textContent = addr;
    } catch {
      /* keep "Email" */
    }
  });
</script>

<style>
  /* ── Header block ─────────────────────────────────────────────────────── */
  .cv-id {
    margin-top: var(--space-5);
  }
  .cv-id__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }
  .cv-id__role {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }
  .cv-id__role span + span::before {
    content: '·';
    margin-right: var(--space-2);
    color: var(--color-text-faint);
  }
  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }
  .cv-contact :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .cv-contact :global(a:hover) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }
  .cv-actions__soon {
    cursor: default;
    border-style: dashed;
    color: var(--color-text-faint);
  }
  .cv-actions__soon:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-faint);
  }
  .cv-actions__updated {
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .cv-notice {
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    border-left: 3px solid var(--color-warm);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-warm-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  /* ── Section jump list ────────────────────────────────────────────────── */
  .cv-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cv-nav a {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 550;
    text-decoration: none;
  }
  .cv-nav a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ── Sections ─────────────────────────────────────────────────────────── */
  .cv {
    --when: 8.5rem;
    --rail-gap: var(--space-5);
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }
  .cv-section {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .cv-section h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-lg);
  }
  .cv-section h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .cv-group + .cv-group {
    margin-top: var(--space-6);
  }
  .cv-group h3 {
    margin: 0 0 var(--space-3) calc(var(--when) + var(--rail-gap));
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .cv-group__count {
    margin-left: 0.3em;
    color: var(--color-text-faint);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Timeline rows: date column | rail | body */
  .cv-row {
    display: grid;
    grid-template-columns: var(--when) 1fr;
    column-gap: var(--rail-gap);
  }
  .cv-row__when {
    padding-top: 0.2em;
    color: var(--color-text-faint);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .cv-row__body {
    position: relative;
    padding: 0 0 var(--space-5) var(--space-5);
    border-left: 1px solid var(--color-border);
  }
  .cv-row__body::before {
    content: '';
    position: absolute;
    top: 0.6em;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 0 0 1.5px var(--color-accent-2);
  }
  .cv-row:last-child .cv-row__body {
    padding-bottom: var(--space-2);
  }
  .cv-row__title {
    font-weight: 600;
    line-height: var(--leading-snug);
  }
  .cv-row__title a {
    color: inherit;
    text-decoration-color: var(--color-border-strong);
  }
  .cv-row__title a:hover {
    color: var(--color-accent);
  }
  .cv-row__line {
    margin-top: 0.15em;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .cv-row__line a {
    color: inherit;
    text-decoration-color: var(--color-border-strong);
  }
  .cv-row__line a:hover {
    color: var(--color-accent);
  }
  .cv-rows--plain {
    --when: 11rem;
  }
  .cv-rows--plain .cv-row__title {
    font-weight: 400;
  }
  .cv-rows--plain .cv-row__when {
    color: var(--color-text-muted);
    font-weight: 550;
  }
  .cv-row__bullets {
    margin: var(--space-2) 0 0;
    padding-left: 1.1em;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .cv-row__bullets li + li {
    margin-top: var(--space-1);
  }
  .cv-row__bullets li::marker {
    color: var(--color-accent-2);
  }
  .cv-inline__note {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .cv-summary {
    margin-bottom: var(--space-6);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }
  .cv-summary strong {
    font-weight: 600;
  }

  /* Publications: label in the date column, citation as body */
  .cv-row__label {
    color: var(--color-accent);
    font-weight: 600;
  }
  .cv-cite {
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .cv-row--pub .cv-row__body {
    padding-bottom: var(--space-4);
  }
  .cv-cite a {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }
  .cv-cite a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }
  .cv-cite em {
    color: var(--color-text-muted);
  }

  .cv-inline {
    display: flex;
    flex-wrap: wrap;
    margin-left: calc(var(--when) + var(--rail-gap));
    font-size: var(--text-sm);
  }
  .cv-inline li:not(:last-child)::after {
    content: '·';
    margin-inline: var(--space-2);
    color: var(--color-text-faint);
  }

  /* Phones: dates above the text, rail on the left edge */
  @media (max-width: 40rem) {
    .cv-rows--plain {
      --when: 0rem;
    }
    .cv-id__role {
      flex-direction: column;
    }
    .cv-id__role span + span::before {
      content: none;
    }
    .cv {
      --when: 0rem;
      --rail-gap: 0rem;
    }
    .cv-row {
      grid-template-columns: 1fr;
      padding-left: var(--space-5);
      border-left: 1px solid var(--color-border);
      position: relative;
    }
    .cv-row::before {
      content: '';
      position: absolute;
      top: 0.55em;
      left: -4px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-bg);
      box-shadow: 0 0 0 1.5px var(--color-accent-2);
    }
    .cv-row__body {
      padding-left: 0;
      border-left: 0;
    }
    .cv-row__body::before {
      display: none;
    }
    .cv-row__when {
      padding-top: 0;
      text-align: left;
      font-size: var(--text-xs);
    }
    .cv-group h3,
    .cv-inline {
      margin-left: 0;
    }
  }

  /* ── Print: a clean, light, paper CV ──────────────────────────────────── */
  @media print {
    .cv-rows--plain {
      --when: 10rem;
    }
    :global(:root),
    :global(:root[data-theme='dark']),
    :global(:root:not([data-theme='light'])) {
      color-scheme: light;
      --color-bg: #fff;
      --color-surface: #fff;
      --color-text: #111;
      --color-text-muted: #333;
      --color-text-faint: #555;
      --color-border: #ccc;
      --color-border-strong: #bbb;
      --color-accent: #0f6e56;
      --color-accent-2: #0f6e56;
    }
    @page {
      margin: 0.6in 0.65in;
    }
    :global(html) {
      font-size: 10pt;
    }
    :global(body) {
      background: #fff;
    }
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.ridges),
    :global(.page-header .eyebrow),
    :global(.page-header h1),
    .cv-nav,
    .cv-actions a,
    .cv-actions__soon,
    .cv-notice {
      display: none !important;
    }
    :global(.page-header) {
      padding: 0 0 var(--space-3) !important;
      border-bottom: 1.5pt solid #0f6e56 !important;
    }
    :global(.page-body) {
      padding-top: 0 !important;
    }
    :global(.container) {
      max-width: none;
      padding-inline: 0;
    }
    .cv-id {
      margin-top: 0;
    }
    .cv-id__name {
      font-size: 22pt;
    }
    .cv-contact {
      margin-top: var(--space-2);
      gap: 0 var(--space-4);
    }
    .cv-contact :global(svg) {
      display: none;
    }
    .cv-actions {
      margin-top: var(--space-1);
    }
    .cv {
      --when: 7rem;
      --rail-gap: var(--space-4);
      gap: var(--space-5);
      margin-top: var(--space-5);
    }
    .cv-section h2 {
      margin-bottom: var(--space-3);
      color: #0f6e56;
      font-family: var(--font-body);
      font-size: 9pt;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      break-after: avoid;
    }
    .cv-group h3 {
      break-after: avoid;
    }
    .cv-row {
      break-inside: avoid;
    }
    .cv-row__body {
      border-left: 0;
      padding-left: 0;
      padding-bottom: var(--space-3);
    }
    .cv-row__body::before {
      display: none;
    }
    .cv-row__when {
      text-align: left;
    }
    :global(main a) {
      color: inherit !important;
      text-decoration: none !important;
    }
  }
</style>
