---
/** Standard inner page: header (eyebrow, title, intro) with quiet hydrograph ridgelines + content. */
import type { Props as HeadProps } from '../components/BaseHead.astro';
import Ridgelines from '../components/Ridgelines.astro';
import BaseLayout from './BaseLayout.astro';

interface Props extends HeadProps {
  title: string;
  eyebrow?: string;
  intro?: string;
  /** Seed for the header ridgelines (a different storm pattern per page). */
  ridges?: number;
}
const { title, eyebrow, intro, ridges = 1, ...head } = Astro.props;
---

<BaseLayout title={title} description={head.description ?? intro} {...head}>
  <header class="page-header">
    <Ridgelines variant="page" seed={ridges} />
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {intro && <p class="page-header__intro">{intro}</p>}
      <slot name="header" />
    </div>
  </header>
  <div class="container page-body">
    <slot />
  </div>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-8) calc(var(--space-7) + 24px);
    border-bottom: 1px solid var(--color-border);
  }
  .page-header h1 {
    margin-top: var(--space-2);
    max-width: 22ch;
  }
  .page-header__intro {
    margin-top: var(--space-4);
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
  .page-body {
    padding-top: var(--space-7);
  }
</style>
