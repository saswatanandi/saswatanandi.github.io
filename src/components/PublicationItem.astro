---
/**
 * One publication in a list: title (→ its page on this site), authors (me in bold), venue,
 * link buttons (DOI, PDF, Code, Data, Slides, Copy BibTeX) and optional citation badges.
 *
 * variant="default": year in a left column (home page, research theme pages).
 * variant="list":    no year column (the /publications/ list has year headings); carries
 *                    data-* attributes used by the tab/filter script.
 */
import type { Publication } from '../lib/bibtex';
import { authorSep, groupOf, venueDetails } from '../lib/bibtex';
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';
import PubBadges from './PubBadges.astro';

interface Props {
  pub: Publication;
  headingLevel?: 'h3' | 'h4';
  variant?: 'default' | 'list';
  /** Show Altmetric / Dimensions badges (if enabled in site.config.yaml and the paper has a DOI). */
  badges?: boolean;
}
const { pub, headingLevel: H = 'h3', variant = 'default', badges = false } = Astro.props;
const details = venueDetails(pub);
const bibId = `bib-${pub.key}`;
const hasBadges = badges && Boolean(pub.doi);
const links = [
  pub.pdf && { href: pub.pdf, label: 'PDF', icon: 'file' as const },
  pub.code && { href: pub.code, label: 'Code', icon: 'github' as const },
  pub.data && { href: pub.data, label: 'Data', icon: 'data' as const },
  pub.slides && { href: pub.slides, label: 'Slides', icon: 'slides' as const },
].filter((l): l is { href: string; label: string; icon: 'file' | 'github' | 'data' | 'slides' } => Boolean(l));
---

<article
  class:list={['pub', `pub--${variant}`, { 'pub--badges': hasBadges }]}
  data-pub={variant === 'list' ? pub.key : undefined}
  data-year={variant === 'list' ? pub.year : undefined}
  data-topics={variant === 'list' ? pub.topics.join(' ') : undefined}
  data-group={variant === 'list' ? groupOf(pub) : undefined}
>
  {variant === 'default' && <div class="pub__year" aria-hidden="true">{pub.year}</div>}
  <div class="pub__body">
    <H class="pub__title"><a href={pub.href} set:html={pub.titleHtml} /></H>
    <p class="pub__authors">
      {
        pub.authors.map((a, i) => (
          <>
            {a.isSelf ? <strong class="pub__self">{a.display}</strong> : a.display}
            {authorSep(i, pub.authors.length)}
          </>
        ))
      }
    </p>
    <p class="pub__venue">
      {pub.venue && <em>{pub.venue}</em>}{details && <span>, {details}</span>}
      {variant === 'default' ? <span class="visually-hidden"> ({pub.year})</span> : <span>, {pub.year}</span>}
    </p>
    <div class="pub__actions">
      {
        pub.doi && (
          <a class="pub__btn" href={`https://doi.org/${pub.doi}`}>
            DOI<span class="visually-hidden">: {pub.doi}</span>
          </a>
        )
      }
      {
        !pub.doi && pub.url && pub.url !== pub.pdf && (
          <a class="pub__btn" href={pub.url}>
            <Icon name="external" size={13} /> Link
          </a>
        )
      }
      {
        links.map((l) => (
          <a class="pub__btn" href={l.href}>
            <Icon name={l.icon} size={13} /> {l.label}
          </a>
        ))
      }
      <CopyButton from={bibId} label="BibTeX" srLabel={`Copy BibTeX for “${pub.title}”`} />
      <template id={bibId} set:text={pub.bibtexClean} />
    </div>
  </div>
  {hasBadges && <PubBadges doi={pub.doi} class="pub__badges" />}
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .pub--list {
    grid-template-columns: minmax(0, 1fr);
  }
  .pub--list.pub--badges {
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-5);
  }
  .pub:first-child {
    padding-top: var(--space-2);
  }
  .pub__year {
    padding-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--color-accent);
  }
  .pub__title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 580;
    line-height: var(--leading-snug);
    letter-spacing: 0;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .pub__title a {
    color: var(--color-text);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition:
      background-size 300ms var(--ease),
      color var(--duration) var(--ease);
  }
  .pub__title a:hover {
    color: var(--color-accent);
    background-size: 100% 1px;
  }
  .pub__authors {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .pub__self {
    color: var(--color-text);
    font-weight: 650;
  }
  .pub__venue {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  .pub__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .pub__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .pub__btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pub :global(.pub__badges) {
    padding-top: 0.2rem;
  }
  @media (max-width: 40rem) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
    .pub--list.pub--badges {
      grid-template-columns: minmax(0, 1fr);
    }
    .pub :global(.pub__badges) {
      margin-top: var(--space-3);
      padding-top: 0;
    }
    .pub__year {
      font-size: var(--text-sm);
    }
  }
</style>
