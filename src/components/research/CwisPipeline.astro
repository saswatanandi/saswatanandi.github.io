---
/**
 * The CWIS workflow as a vertical timeline (redrawn from the original CWIS flowchart):
 * one row per stage on a rail, with the
 * re-calibration loop drawn beside the rail from stage 04 back to stage 02.
 * Pure HTML/CSS, identical at every width. Edit the `stages` list to change the wording.
 */
interface Props {
  /** Accessible description of the whole diagram. */
  label: string;
}
const { label } = Astro.props;

const icons = {
  data: '<path d="M7 16a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 17 8.5a3.75 3.75 0 0 1 .5 7.47"/><path d="M8 19v2M12 18v3M16 19v2"/>',
  model: '<path d="m12 3 9 4.5-9 4.5-9-4.5z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/>',
  forecast: '<path d="M3 20h18"/><path d="M4 16l4-5 4 3 3-4"/><path d="M15 10l5-4" stroke-dasharray="2 2.5"/>',
  verify: '<circle cx="12" cy="12" r="9"/><path d="m8 12.5 3 3 5-6.5"/>',
  bank: '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"/>',
  app: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M7 13l3-3 3 2 4-4"/>',
} as const;

/** `term` is shown in bold before its text; items are joined with a middle dot. */
type Item = { term?: string; text: string };
const stages: { title: string; icon: keyof typeof icons; tone?: 'slate' | 'warm'; items: Item[] }[] = [
  {
    title: 'Data acquisition',
    icon: 'data',
    tone: 'slate',
    items: [
      { term: 'MAPT', text: 'weather forcing, historical and forecast' },
      { term: 'VAPT', text: 'satellite LAI, albedo, NDVI, canopy cover' },
      { term: 'VFT', text: 'AI vegetation forecasts' },
    ],
  },
  {
    title: 'Hydrologic simulation',
    icon: 'model',
    items: [{ term: 'VIC', text: '1 km, daily' }, { text: 'historical run: VAPT + MAPT' }, { text: 'ET, soil moisture, snow, streamflow' }],
  },
  { title: 'Forecast', icon: 'forecast', items: [{ text: 'forecast run: VFT + MAPT' }] },
  {
    title: 'Verification',
    icon: 'verify',
    items: [{ term: 'MVT', text: 'multi-point verification' }, { text: 'CDEC and SNOTEL: discharge, ET, snow' }],
  },
  {
    title: 'Hydrologic data bank',
    icon: 'bank',
    items: [{ text: 'geospatial and time-series database' }, { text: 'cataloguing, QA/QC' }, { term: 'API', text: 'for the web app' }],
  },
  { title: 'Web app', icon: 'app', tone: 'warm', items: [{ text: 'maps, dashboard, statistics, downloads' }] },
];
/** The loop runs from this stage (index) back to `LOOP_TO`. */
const LOOP_FROM = 3;
const LOOP_TO = 1;
const loopPart = (i: number) =>
  i === LOOP_TO ? 'loop-start' : i === LOOP_FROM ? 'loop-end' : i > LOOP_TO && i < LOOP_FROM ? 'loop-mid' : undefined;
---

<div class="cwis" role="img" aria-label={label}>
  <ol class="cwis__rail" aria-hidden="true">
    {
      stages.map((s, i) => (
        <li class:list={['st', s.tone && `st--${s.tone}`, loopPart(i)]}>
          <span class="st__node">
            <svg viewBox="0 0 24 24" width="18" height="18" set:html={icons[s.icon]} />
          </span>
          <div class="st__body">
            <p class="st__title">
              <span class="st__num">{String(i + 1).padStart(2, '0')}</span>
              {s.title}
            </p>
            <p class="st__detail">
              {s.items.map((it, k) => (
                <>
                  {k > 0 && <span class="st__sep">&nbsp;· </span>}
                  {it.term && <b>{it.term} </b>}
                  {it.text}
                </>
              ))}
            </p>
            {i === LOOP_FROM && (
              <p class="st__loop">
                ↺ re-calibrate and re-run {String(LOOP_TO + 1).padStart(2, '0')} if unsatisfactory
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .cwis {
    --node: 2.5rem;
    --loop-x: -1.5rem; /* where the loop bracket runs, left of the rail */
    --loop: var(--color-accent-2);
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-4);
    font-family: var(--font-body);
  }
  .cwis__rail {
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }
  .st {
    --tone: var(--color-accent);
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    column-gap: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .st:last-child {
    padding-bottom: 0;
  }
  .st--slate {
    --tone: var(--color-text-muted);
  }
  .st--warm {
    --tone: var(--color-warm);
  }
  /* the rail: from below this node to the next one */
  .st:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 0.75px);
    top: var(--node);
    bottom: 0;
    border-left: 1.5px solid var(--color-border-strong);
  }
  .st__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1.5px solid var(--tone);
    border-radius: 50%;
    background: var(--color-surface);
  }
  .st__node svg {
    fill: none;
    stroke: var(--tone);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .st__body {
    min-width: 0;
    padding-top: 0.4rem;
  }
  .st__title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }
  .st__num {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-faint);
    font-variant-numeric: oldstyle-nums;
  }
  .st__detail {
    margin-top: 0.2rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .st__detail b {
    font-weight: 650;
    color: var(--color-text);
  }
  .st__sep {
    color: var(--color-text-faint);
  }
  .st__loop {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Re-calibration loop, drawn in pieces so it needs no measuring:
     start (stage 02) = hook from its node down, mid = straight, end (stage 04) = hook up to its node. */
  .loop-start::after,
  .loop-mid::after,
  .loop-end::after {
    content: '';
    position: absolute;
    left: var(--loop-x);
    width: calc(-1 * var(--loop-x) - 0.35rem);
    border-left: 1.5px dashed var(--loop);
  }
  .loop-start::after {
    top: calc(var(--node) / 2);
    bottom: 0;
    border-top: 1.5px dashed var(--loop);
    border-top-left-radius: 10px;
  }
  .loop-mid::after {
    top: 0;
    bottom: 0;
  }
  .loop-end::after {
    top: 0;
    height: calc(var(--node) / 2);
    border-bottom: 1.5px dashed var(--loop);
    border-bottom-left-radius: 10px;
  }
  /* arrowhead into stage 02's node */
  .loop-start .st__node::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: calc(50% - 5.5px);
    border: 5.5px solid transparent;
    border-left: 8px solid var(--loop);
    border-right: 0;
  }

  @media (max-width: 30rem) {
    .cwis {
      padding: var(--space-4) var(--space-3) var(--space-4) var(--space-2);
    }
    .cwis__rail {
      padding-left: 1.6rem;
    }
    .st__title {
      font-size: 1.02rem;
    }
  }
</style>
