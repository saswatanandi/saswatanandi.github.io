---
import { site } from '../lib/config';
import { profileLinks } from '../lib/links';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';

const links = profileLinks(site);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <ul role="list" class="site-footer__social" aria-label="Profiles and feeds">
      {
        site.email && (
          <li>
            <EmailLink email={site.email} class="icon-link" label="Email">
              <Icon name="mail" size={20} />
            </EmailLink>
          </li>
        )
      }
      {
        links.map((l) => (
          <li>
            <a class="icon-link" href={l.href} aria-label={l.label} title={l.label} rel="me noopener">
              <Icon name={l.icon} size={18} />
            </a>
          </li>
        ))
      }
      <li>
        <a class="icon-link" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
          <Icon name="rss" size={20} />
        </a>
      </li>
    </ul>

    <p class="site-footer__meta">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-5);
  }
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }
  .site-footer__social :global(.icon-link) {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }
  .site-footer__social :global(.icon-link:hover) {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .site-footer__meta {
    color: var(--color-text-muted);
  }
</style>
