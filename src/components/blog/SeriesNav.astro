---
/** "Part n of m" box listing the other posts of a series, oldest first. */
import type { Post } from '../../lib/blog';

interface Props {
  name: string;
  posts: Post[];
  current: string;
}
const { name, posts, current } = Astro.props;
const index = posts.findIndex((p) => p.id === current);
---

{
  posts.length > 1 && (
    <nav class="series" aria-label={`Series: ${name}`} data-pagefind-ignore>
      <p class="series__head">
        Series: <strong>{name}</strong>, part {index + 1} of {posts.length}
      </p>
      <ol>
        {posts.map((p) => (
          <li>{p.id === current ? <span aria-current="page">{p.data.title}</span> : <a href={`/blog/${p.id}/`}>{p.data.title}</a>}</li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .series {
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-warm);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }
  .series__head {
    color: var(--color-text-muted);
  }
  .series ol {
    margin-top: var(--space-2);
    padding-left: 1.4em;
    display: grid;
    gap: 0.2rem;
  }
  .series [aria-current] {
    font-weight: 600;
  }
</style>
