---
import type { CollectionEntry } from 'astro:content';
import { FIGURE_COMPONENTS } from '../schemas/content';
import ThemeFigure from './ThemeFigure.astro';

interface Props {
  theme: CollectionEntry<'research'>;
  index: number;
  /** "card" = home page grid; "row" = wide row on /research/. */
  layout?: 'card' | 'row';
}
const { theme, index, layout = 'card' } = Astro.props;
const { title, summary, image, thumbnail } = theme.data;
const pic = thumbnail ?? ((FIGURE_COMPONENTS as readonly string[]).includes(image) ? undefined : image);
const H = layout === 'row' ? 'h2' : 'h3';
---

<a class:list={['tile', `tile--${layout}`, { 'tile--nopic': !pic }]} href={`/research/${theme.id}/`}>
  <span class="tile__inner">
    {
      pic && (
        <span class="tile__pic">
          <ThemeFigure src={pic} alt="" variant="thumb" />
        </span>
      )
    }
    <span class="tile__body">
      <span class="tile__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <H class="tile__title">{title}</H>
      <span class="tile__summary">{summary}</span>
      <span class="tile__more" aria-hidden="true">Read more →</span>
    </span>
  </span>
</a>

<style>
  /*
   * One responsive scheme for both uses (home grid and /research/ rows), driven by the
   * card's OWN width (container query), not the viewport:
   *   • card narrower than 34rem  → picture band on top (fixed height), text below;
   *   • card 34rem or wider       → picture panel on the left, stretched to the card's height.
   * The drawing is always scaled to fit (never cropped or enlarged beyond its panel).
   */
  .tile {
    display: block;
    height: 100%;
    container: tile / inline-size;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .tile:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .tile__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  /* Stacked: fixed-height picture band */
  .tile__pic {
    display: block;
    flex: none;
    width: 100%;
    min-width: 0;
    height: 10.5rem;
    overflow: hidden;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  .tile__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .tile__num {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-variant-numeric: oldstyle-nums;
    color: var(--color-text-faint);
  }
  .tile__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: var(--leading-snug);
    color: inherit;
  }
  .tile__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .tile__more {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Side by side: picture panel on the left, stretched to the card's height */
  @container tile (min-width: 34rem) {
    .tile:not(.tile--nopic) .tile__inner {
      display: grid;
      grid-template-columns: clamp(9rem, 33%, 17rem) minmax(0, 1fr);
    }
    .tile__pic {
      width: auto;
      height: auto;
      min-height: 10rem;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
    .tile__body {
      justify-content: center;
      padding: var(--space-5) var(--space-6);
    }
    .tile__more {
      margin-top: var(--space-1);
    }
  }
  /* Row cards (/research/): slightly larger type, full size only once the card is wide */
  @container tile (min-width: 34rem) {
    .tile--row .tile__title {
      font-size: var(--text-lg);
    }
  }
  @container tile (min-width: 50rem) {
    .tile__body {
      padding: var(--space-6);
    }
    .tile--row .tile__title {
      font-size: var(--text-xl);
    }
    .tile--row .tile__summary {
      font-size: var(--text-base);
    }
  }
</style>
