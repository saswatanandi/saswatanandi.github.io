---
/** Site mark: the "contour drop" (see src/lib/logo.ts). Decorative next to the name. */
import { markBody } from '../lib/logo';

interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
// Unique, deterministic mask id per instance (the mark can appear more than once on a page).
const g = globalThis as { __logoCount?: number };
g.__logoCount = (g.__logoCount ?? 0) + 1;
const id = `logo-${g.__logoCount}`;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  set:html={markBody(id, size <= 24)}
/>
