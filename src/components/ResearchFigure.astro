---
/**
 * One figure on a research theme page: the picture (raster pictures open full size
 * when clicked), its caption and an optional "View full diagram" link.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ThemeFigure from './ThemeFigure.astro';

interface Props {
  image: string;
  alt: string;
  caption?: string;
  full?: string;
}
const { image, alt, caption, full } = Astro.props;

const rasters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/research/*.{png,jpg,jpeg,webp,avif,PNG,JPG,JPEG}', {
  eager: true,
});
const meta = rasters[`/src/assets/research/${image}`]?.default;
const zoomHref = meta ? (await getImage({ src: meta, width: meta.width })).src : undefined;
---

<figure class="figure">
  {
    zoomHref ? (
      <a href={zoomHref} class="figure__zoom" aria-label="Open the full-size image">
        <ThemeFigure src={image} alt={alt} />
      </a>
    ) : (
      <ThemeFigure src={image} alt={alt} />
    )
  }
  {
    (caption || full) && (
      <figcaption>
        {caption}
        {full && (
          <>
            {' '}
            <a href={full}>
              View full diagram<span aria-hidden="true"> ↗</span>
            </a>
          </>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-block: var(--space-7);
    margin-inline: 0;
  }
  .figure__zoom {
    display: block;
    cursor: zoom-in;
  }
  .figure :global(.tfig) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }
  .figure :global(.tfig > svg) {
    padding: var(--space-4);
  }
  .figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
  .figure figcaption a {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
