---
/**
 * Headshot sitting on a "summit": irregular contour rings around the portrait.
 * Rings are generated at build time from the same contour engine as the site motif.
 */
import { peakPaths } from '../lib/motifs';

interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
const rings = peakPaths({ size: 400, radii: [0.78, 0.86, 0.94], seed: 8, wobble: 0.035, cell: 4 });
---

<div class="peak">
  <svg class="peak__rings" viewBox="0 0 400 400" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
    {rings.map((r, i) => <path d={r.d} stroke-width={i === 0 ? 1.6 : 1.1} opacity={0.95 - i * 0.28} />)}
  </svg>
  <img class="peak__photo" src={src} alt={alt} width="256" height="256" loading="eager" fetchpriority="high" decoding="async" />
</div>

<style>
  .peak {
    position: relative;
    width: min(100%, 320px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .peak__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-accent-2);
  }
  .peak__photo {
    width: 70%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--color-bg),
      0 0 0 5px var(--color-border-strong),
      var(--shadow-md);
    background: var(--color-surface-2);
  }
</style>
